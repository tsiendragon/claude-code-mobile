<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ (API >= 31) cloud-backup + device-transfer rules.
     Same intent as backup_rules.xml: keep the non-secret URL/mode mirror,
     exclude the encrypted token store. -->
<data-extraction-rules>
    <!-- Explicit include => the encrypted token store is excluded by default. -->
    <cloud-backup>
        <include domain="sharedpref" path="FlutterSharedPreferences.xml" />
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="FlutterSharedPreferences.xml" />
    </device-transfer>
</data-extraction-rules>
