{
  "host": "127.0.0.1",
  "port": 8900,
  "token_env": "CCM_TOKEN",
  "workspace_root": "~/workspace",
  "allowed_paths": ["~/workspace", "~/apps"],
  "repos": [
    { "name": "claude-code-mobile", "path": "~/apps/claude-code-mobile" },
    { "name": "claude-code-connector", "path": "~/apps/claude-code-connector" },
    { "name": "TAMart", "path": "~/apps/TAMart" },
    { "name": "finnotev2", "path": "~/apps/finnotev2" },
    { "name": "iterative-proof-engine", "path": "~/apps/iterative-proof-engine" },
    { "name": "wg-admin", "path": "~/apps/wg-admin" }
  ],
  "allow_manual_cwd": true,
  "ccc_bin": "ccc",
  "poll_interval_ms": 1000,
  "event_buffer_size": 200,
  "max_prompt_bytes": 102400,
  "max_ws_message_bytes": 262144,
  "max_event_bytes": 524288,
  "allow_wide_bind": true,
  "allow_hidden_cwd": false,
  "log_level": "info",
  "ccc_timeout_ms": 15000
}
