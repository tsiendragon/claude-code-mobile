{
  "name": "@ccm/bridge-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/index.ts",
    "start": "node dist/src/index.js",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "e2e:smoke": "node scripts/e2e-smoke.mjs",
    "gen-test-from-failure": "node scripts/gen-test-from-failure.mjs"
  },
  "dependencies": {
    "sharp": "^0.35.1",
    "ws": "^8.17.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/node": "^20.12.12",
    "@types/sharp": "^0.32.0",
    "@types/ws": "^8.5.10",
    "tsx": "^4.15.1",
    "typescript": "^5.4.5",
    "vitest": "^1.6.0"
  }
}
